generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  companyId    String?  @unique
  createdAt    DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
}

// MSME Business Profile
model Company {
  id           String   @id @default(cuid())
  name         String   @default("")
  industry     String   @default("")
  state        String   @default("")
  udyamNo      String?  @unique
  turnoverCr   Float    @default(0)
  certificates String   @default("")
  keywords     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  savedTenders SavedTender[]
  alertSetting AlertSetting?
  user         User?
}

// Government Tender Information
model Tender {
  id            String   @id @default(cuid())
  title         String
  department    String
  category      String
  state         String
  valueCr       Float
  minTurnoverCr Float?
  requiredCerts String   @default("")
  emdExempt     Boolean  @default(false)
  deadline      DateTime
  sourceUrl     String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  savedTenders SavedTender[]
}

// Bookmarked Tenders
model SavedTender {
  id        String   @id @default(cuid())
  companyId String
  tenderId  String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tender  Tender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([companyId, tenderId])
}

// Alert preferences for the demo company
model AlertSetting {
  id                String   @id @default(cuid())
  companyId         String   @unique
  newMatches        Boolean  @default(true)
  deadlineReminders Boolean  @default(true)
  weeklySummary     Boolean  @default(false)
  email             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
